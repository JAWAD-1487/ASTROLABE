# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Docker default shown below)
DATABASE_URL="postgresql://astrolabe:astrolabe@localhost:5432/astrolabe"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ───────────────────────────────────────────────────────────────────────
# The Next.js dev server origin — must match frontend port exactly
FRONTEND_ORIGIN=http://localhost:3000

# ── Gemini API keys (one key per model tier) ───────────────────────────────────
# Primary:  gemini-2.5-flash
GEMINI_KEY_FLASH=your_gemini_flash_key_here

# Fallback 1: gemini-2.0-flash-lite
GEMINI_KEY_FLASH_LITE=your_gemini_flash_lite_key_here

# Fallback 2: gemini-1.5-flash-8b
GEMINI_KEY_FLASH_8B=your_gemini_flash_8b_key_here


# ── Session ────────────────────────────────────────────────────────────────────
# Generate a strong random string for production: openssl rand -base64 32
SESSION_SECRET=change_me_in_production
